# Live generation needs ONE of these:
# a free Gemini key from https://aistudio.google.com/apikey (no card needed)
GEMINI_API_KEY=
# or an Anthropic key
ANTHROPIC_API_KEY=
# or Vercel AI Gateway (on Vercel, the OIDC token is used automatically; needs a card on file)
AI_GATEWAY_API_KEY=
# Optional: persist generated guides on Vercel
BLOB_READ_WRITE_TOKEN=
# GEMINI_MODEL=gemini-2.5-flash
